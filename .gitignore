# Publication allowlist: everything is excluded unless explicitly allowed below.
*
!/.gitignore
!/README.md
!/requirements.txt
!/app.py
!/medical_theme.py
!/medical_ui_enhancements.py
!/create_b2_expanded_dataset.py
!/evaluate_ensemble.py

!/pages/
!/pages/**/
