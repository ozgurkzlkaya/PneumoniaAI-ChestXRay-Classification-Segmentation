!/PneumoniaAI_Training_Source/**/*.py
!/b3_preprocessing_source/
!/b3_preprocessing_source/**/
!/b3_preprocessing_source/**/*.py

!/assets/
!/assets/pneumonia_ai_logo.png
!/.streamlit/
!/.streamlit/config.toml

# Deny caches, environments, backups, archives and secrets even within code trees.
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.backup
*.backup-*
*.bak
*.tmp
*.temp
*~
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.keras
*.h5
*.hdf5
*.ckpt*
*.weights.*
*.onnx
*.tflite
*.pt
*.pth
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
credentials.json
secrets.*
.streamlit/secrets.toml
.aws/
.vscode/
.idea/
.DS_Store
Thumbs.db

